# Environment: dev | staging | prod
NODE_ENV=dev

# Transport: stdio (default, for local AI clients) | http (for remote deployment)
TRANSPORT=stdio
PORT=3000
# Bearer token required on /mcp in http transport. Must match the agent's MCP_AUTH_TOKEN.
# Leave unset for stdio/local dev (server logs a warning if http runs without it).
# MCP_AUTH_TOKEN=

# Guarded Remediation write tools (k8s_rollout_restart). Off by default — when off the
# tools aren't even registered. Namespaces must be explicitly allowed (empty = all blocked).
# MCP_ENABLE_WRITE_TOOLS=true
# ALLOWED_REMEDIATION_NAMESPACES=dev-auth,payment
# MAX_SCALE_DELTA=5

# Kubernetes
# Use 'kubeconfig' for file-based auth, 'incluster' for in-cluster auth
K8S_AUTH_MODE=kubeconfig
K8S_KUBECONFIG_PATH=~/.kube/config

# Prometheus
PROMETHEUS_URL=http://localhost:9090

# Alertmanager — the source of truth for what is firing (alertmanager_get_alerts).
# Every evaluator routes here, and only it knows about silences and inhibition.
ALERTMANAGER_URL=http://localhost:9093
# ALERTMANAGER_USERNAME=
# ALERTMANAGER_PASSWORD=

# Loki
LOKI_URL=http://localhost:3100

# Tracing (distributed traces). Backend: tempo | jaeger
# OTel Collector is ingest-only — point TRACING_URL at the store it exports to (Tempo/Jaeger).
# Tracing tools error clearly until TRACING_URL is set.
# TRACING_BACKEND=tempo
# TRACING_URL=http://localhost:3200        # Tempo query (e.g. 3200) or Jaeger query (e.g. 16686)
# TRACING_USERNAME=
# TRACING_PASSWORD=

# Optional: Basic auth for Prometheus/Loki
# PROMETHEUS_USERNAME=
# PROMETHEUS_PASSWORD=
# LOKI_USERNAME=
# LOKI_PASSWORD=

# Max wait on any upstream (K8s/Prometheus/Loki) in seconds before failing the tool
# UPSTREAM_TIMEOUT_SECONDS=30
# Cap on items returned by namespaced list tools (pods/events/configmaps/secrets)
# K8S_LIST_LIMIT=100

# Log level: error | warn | info | http | debug (default: debug in dev, info in prod)
# LOG_LEVEL=info
